{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    // The story and the frames contract are JavaScript so a template with no
    // build step can import them. allowJs permits that; checkJs is what keeps
    // them checked — without it a mistyped `align` survives to runtime.
    "allowJs": true,
    "checkJs": true
  },
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": [
    "dist",
    // Runs in a Worker, not a window. Checked against DOM globals, correct
    // worker code is rejected and a clean scaffold fails to build.
    "src/lib/decoder.worker.js"
  ]
}
